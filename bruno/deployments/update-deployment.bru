meta {
  name: Update Deployment
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/deployment/{{namespace}}/{{deploymentName}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "nginx-deployment",
    "namespace": "default",
    "image": "nginx:1.26",
    "replicas": 3,
    "labels": {
      "app": "nginx",
      "version": "v2"
    },
    "ports": [
      { "containerPort": 80 }
    ],
    "resources": {
      "requests": { "cpu": "100m", "memory": "64Mi" },
      "limits":   { "cpu": "500m", "memory": "256Mi" }
    },
    "strategy": {
      "type": "RollingUpdate",
      "maxSurge": "1",
      "maxUnavailable": "0"
    }
  }
}
