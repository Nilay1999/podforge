meta {
  name: Create Deployment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/deployment/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "nginx-deployment",
    "namespace": "default",
    "image": "nginx:1.25",
    "replicas": 2,
    "labels": {
      "app": "nginx"
    },
    "ports": [
      { "containerPort": 80 }
    ],
    "envVars": {
      "ENV": "dev"
    },
    "resources": {
      "requests": { "cpu": "100m", "memory": "64Mi" },
      "limits":   { "cpu": "500m", "memory": "256Mi" }
    },
    "strategy": {
      "type": "RollingUpdate",
      "maxSurge": "1",
      "maxUnavailable": "0"
    }
  }
}
