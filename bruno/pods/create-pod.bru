meta {
  name: Create Pod
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/pod/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "nginx-pod",
    "namespace": "default",
    "labels": {
      "app": "nginx"
    },
    "containers": [
      {
        "name": "nginx",
        "image": "nginx:1.25",
        "ports": [
          { "containerPort": 80 }
        ],
        "envVars": {
          "ENV": "dev"
        },
        "resources": {
          "requests": { "cpu": "100m", "memory": "64Mi" },
          "limits":   { "cpu": "250m", "memory": "128Mi" }
        }
      }
    ],
    "restartPolicy": "Always"
  }
}
