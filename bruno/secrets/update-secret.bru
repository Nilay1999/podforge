meta {
  name: Update Secret
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/secret/{{namespace}}/{{secretName}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "app-secret",
    "namespace": "default",
    "type": "Opaque",
    "stringData": {
      "DB_PASSWORD": "newpassword123",
      "API_KEY": "xyz789"
    }
  }
}
