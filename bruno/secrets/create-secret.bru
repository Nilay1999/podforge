meta {
  name: Create Secret
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/secret/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "app-secret",
    "namespace": "default",
    "type": "Opaque",
    "stringData": {
      "DB_PASSWORD": "supersecret",
      "API_KEY": "abc123"
    }
  }
}
